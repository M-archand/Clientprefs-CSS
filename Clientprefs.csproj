<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
    <GenerateRuntimeConfigurationFiles>false</GenerateRuntimeConfigurationFiles>
    <OutputPath>$(MSBuildThisFileDirectory)\BuildOutput\plugins\Clientprefs\</OutputPath>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
  </PropertyGroup>

  <ItemGroup>
    <Compile Remove="ClientprefsApi/**/*.cs" />
  </ItemGroup>

 <ItemGroup>
    <PackageReference Include="CounterStrikeSharp.API" Version="1.0.369">
      <PrivateAssets>none</PrivateAssets>
      <ExcludeAssets>runtime</ExcludeAssets>
      <IncludeAssets>compile; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>

    <PackageReference Include="MySqlConnector" Version="2.6.2" />
    <PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.13" />
    <PackageReference Include="Dapper" Version="2.1.89" />
    <ProjectReference Include="ClientprefsApi\ClientprefsApi.csproj" />

  </ItemGroup>

  <ItemGroup>
    <None Include="src\lang\**\*.*" CopyToOutputDirectory="PreserveNewest" Link="lang\%(RecursiveDir)%(Filename)%(Extension)" />
  </ItemGroup>

  <Target Name="ExcludeStoreApiFiles" AfterTargets="Build">
    <PropertyGroup>
      <_RuntimesDir>$([MSBuild]::NormalizeDirectory('$(OutputPath)', 'runtimes'))</_RuntimesDir>
      <_RuntimeRidDirs Condition="Exists('$(_RuntimesDir)')">$([System.IO.Directory]::GetDirectories('$(_RuntimesDir)'))</_RuntimeRidDirs>
    </PropertyGroup>
    <ItemGroup>
      <HostProvidedOutputFiles Include="$(OutputPath)Microsoft.Extensions.*" />
      <HostProvidedOutputFiles Include="$(OutputPath)Microsoft.DotNet.PlatformAbstractions.dll" />
      <HostProvidedOutputFiles Include="$(OutputPath)Serilog*" />
      <HostProvidedOutputFiles Include="$(OutputPath)Tomlyn.dll" />
      <HostProvidedOutputFiles Include="$(OutputPath)Scrutor.dll" />
      <HostProvidedOutputFiles Include="$(OutputPath)FastGenericNew.dll" />
      <HostProvidedOutputFiles Include="$(OutputPath)System.Diagnostics.EventLog.dll" />
      <HostProvidedOutputFiles Include="$(OutputPath)McMaster.NETCore.Plugins.dll" />
      <HostProvidedOutputFiles Include="$(OutputPath)ClientprefsApi.dll" />
      <HostProvidedOutputFiles Include="$(OutputPath)ClientprefsApi.pdb" />
      <_RuntimeRidDirs Include="$(_RuntimeRidDirs)" />
      <_RuntimeRidDirsToRemove Include="@(_RuntimeRidDirs)" Condition="'%(Filename)%(Extension)' != 'linux-x64' And '%(Filename)%(Extension)' != 'win-x64'" />
    </ItemGroup>
    <Delete Files="@(HostProvidedOutputFiles)" />
    <RemoveDir Directories="@(_RuntimeRidDirsToRemove)" />
  </Target>

</Project>